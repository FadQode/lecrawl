# LexCrawl configuration. Copy to `.env` and fill in the fields you need.

# --- Runtime ---------------------------------------------------------------
LEXCRAWL_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Crawl policy ----------------------------------------------------------
CRAWL_USER_AGENT=LexCrawl/0.1 (+https://github.com/OWNER/lexcrawl)
CRAWL_REQUEST_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_RETRY_BACKOFF_SECONDS=1.5
CRAWL_REQUEST_DELAY_SECONDS=1.0
CRAWL_MAX_LISTING_PAGES=25
CRAWL_MAX_RESPONSE_BYTES=26214400

# --- Canadian Bar Association (news releases) ------------------------------
RELEASES_API_URL=https://cba.ca/advantageapi/content/get/Article/en-us
RELEASES_SITE_URL=https://cba.ca
RELEASES_ARTICLE_PATH=/article/
RELEASES_TYPE_ID=6fe4eaca-ea7a-4e64-8147-49562f77b7a8
RELEASES_API_LANGUAGE=en-us
RELEASES_PAGE_SIZE=50
RELEASES_MAX_PAGES=10

# --- Output ----------------------------------------------------------------
OUTPUT_DIR=data
CHECK_STATE_PATH=data/state/checks.json
IDENTITIES_STATE_PATH=data/state/identities.json

# --- U.S. Department of Commerce (reports, acquired via Firecrawl) ---------
REPORTS_LISTING_URL=https://www.commerce.gov/data-and-reports/reports
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
FIRECRAWL_TIMEOUT_SECONDS=90
FIRECRAWL_MAX_RETRIES=2
FIRECRAWL_REQUEST_DELAY_SECONDS=1.5
FIRECRAWL_MAX_PAGES_PER_RUN=6
FIRECRAWL_MAX_DETAIL_SCRAPES_PER_RUN=20
FIRECRAWL_MIN_BODY_WORDS=30
FIRECRAWL_CACHE_DIR=data/firecrawl-cache

# --- UAE Legislation (news; direct fetch with Firecrawl fallback) ----------
LISTINGS_URL=https://uaelegislation.gov.ae/ar/news
LISTINGS_LANGUAGE=ar
UAE_DIRECT_FETCH=true
UAE_MAX_DETAIL_SCRAPES_PER_RUN=20

# --- Daily scheduler -------------------------------------------------------
SCHEDULE_ENABLED=true
SCHEDULE_DAILY_CRON=0 6 * * *
SCHEDULE_TIMEZONE=UTC

# --- Guards ----------------------------------------------------------------
ANOMALY_MAX_NEW_ITEMS=10
FIRECRAWL_MONTHLY_CREDIT_CAP=900

# --- Local JSON state (only used when STATE_BACKEND=json) ----------------------------------------------
USAGE_STATE_PATH=data/state/usage.json
RUN_LOCK_PATH=data/state/run.lock
SCHEDULE_LOCK_PATH=data/state/scheduler.lock

# --- PostgreSQL (application-default state backend) ------------------------
DATABASE_URL=postgresql+psycopg://lexcrawl:lexcrawl@localhost:5432/lexcrawl
STATE_BACKEND=db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# --- Attachment extraction ------------------------------------------------
RESOURCE_EXTRACTION_ATTEMPTS=3
RESOURCE_MAX_BYTES=20000000
RESOURCE_CLAIM_LEASE_SECONDS=300

# --- Documentation retry / reconciliation ----------------------------------
DOCUMENT_EXTRACTION_ATTEMPTS=3
RECONCILE_INTERVAL_DAYS=7

# --- HTTP API --------------------------------------------------------------
# API_TOKEN is required for every non-health endpoint (no default).
API_TOKEN=
API_HOST=0.0.0.0
API_PORT=8000
