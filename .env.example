LEXCRAWL_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+psycopg://lexcrawl:lexcrawl@localhost:5432/lexcrawl
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

API_HOST=0.0.0.0
API_PORT=8000
API_PAGE_SIZE_DEFAULT=25
API_PAGE_SIZE_MAX=200

CRAWL_USER_AGENT=LexCrawl/0.1 (+https://github.com/OWNER/lexcrawl)
CRAWL_REQUEST_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_RETRY_BACKOFF_SECONDS=1.5
CRAWL_CONCURRENCY_PER_SOURCE=3
CRAWL_REQUEST_DELAY_SECONDS=1.0
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_MAX_LISTING_PAGES=25
CRAWL_ENGINE=http

BROWSER_HEADLESS=true
BROWSER_WAIT_UNTIL=domcontentloaded
BROWSER_SETTLE_MILLISECONDS=250

LISTINGS_URL=
LISTINGS_LANGUAGE=
LISTINGS_SECONDARY_URL=
CRAWL_BILINGUAL=false

REPORTS_LISTING_URL=
REPORTS_API_URL=
REPORTS_API_KEY=
REPORTS_ARTICLE_HOST=
REPORTS_ARTICLE_PATHS=
REPORTS_NEWS_TYPES=
REPORTS_PAGE_SIZE=50
REPORTS_MAX_PAGES=4

FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_PAGES_PER_RUN=6
FIRECRAWL_MAX_DETAIL_SCRAPES_PER_RUN=20
FIRECRAWL_REQUEST_DELAY_SECONDS=1.5
FIRECRAWL_MAX_RETRIES=2
FIRECRAWL_TIMEOUT_SECONDS=90
FIRECRAWL_MIN_BODY_WORDS=30
FIRECRAWL_CACHE_DIR=data/firecrawl-cache
FIRECRAWL_INCOMPLETE_MAX_ATTEMPTS=3
FIRECRAWL_INCOMPLETE_RETRIES_PER_RUN=5

RELEASES_API_URL=
RELEASES_SITE_URL=
RELEASES_ARTICLE_PATH=/article/
RELEASES_TYPE_ID=
RELEASES_API_LANGUAGE=
RELEASES_PAGE_SIZE=50
RELEASES_MAX_PAGES=10

PDF_MAX_BYTES=26214400
PDF_EXTRACTION_TIMEOUT_SECONDS=60

SCHEDULE_ENABLED=true
SCHEDULE_DAILY_CRON=0 3 * * *
SCHEDULE_TIMEZONE=UTC
MANUAL_TRIGGER_TOKEN=

OUTPUT_DIR=data
