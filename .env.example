# LexCrawl configuration. Copy to `.env` and fill in the fields you need.

# --- Runtime ---------------------------------------------------------------
LEXCRAWL_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Crawl policy ----------------------------------------------------------
CRAWL_USER_AGENT=LexCrawl/0.1 (+https://github.com/OWNER/lexcrawl)
CRAWL_REQUEST_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_RETRY_BACKOFF_SECONDS=1.5
CRAWL_REQUEST_DELAY_SECONDS=1.0
CRAWL_MAX_LISTING_PAGES=25
CRAWL_MAX_RESPONSE_BYTES=26214400

# --- Canadian Bar Association (news releases) ------------------------------
RELEASES_API_URL=https://cba.ca/advantageapi/content/get/Article/en-us
RELEASES_SITE_URL=https://cba.ca
RELEASES_ARTICLE_PATH=/article/
RELEASES_TYPE_ID=6fe4eaca-ea7a-4e64-8147-49562f77b7a8
RELEASES_API_LANGUAGE=en-us
RELEASES_PAGE_SIZE=50
RELEASES_MAX_PAGES=10

# --- Output ----------------------------------------------------------------
OUTPUT_DIR=data
